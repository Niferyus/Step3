{
    "ReverseProxy": {
        "Routes": {
            "AuthRoute": {
                "ClusterId": "AuthCluster",
                "Match": {
                    "Path": "/auth/{**catch-all}"
                },
                "Metadata": {
                    "Microsoft.AspNetCore.RateLimiting.EnableRateLimiting": "ApiPolicy"
                }
            },
            "ProductRoute": {
                "ClusterId": "ProductCluster",
                "Match": {
                    "Path": "/product/{**catch-all}"
                },
                "Metadata": {
                    "Microsoft.AspNetCore.RateLimiting.EnableRateLimiting": "ProductListPolicy"
                }
            },
            "ProductUpdateRoute": {
                "ClusterId": "ProductCluster",
                "Match": {
                    "Path": "/product/update/{**catch-all}"
                },
                "AuthorizationPolicy": "ProductUpdatePolicy"
            }
        },
        "Clusters": {
            "AuthCluster": {
                "Destinations": {
                    "authApi": {
                        "Address": "http://localhost:5020"
                    }
                }
            },
            "ProductCluster": {
                "Destinations": {
                    "productApi": {
                        "Address": "http://localhost:8082"
                    }
                }
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}